# Cloudflare Pages response headers.
#
# Format (developers.cloudflare.com/pages/configuration/headers):
#   a line starting with "/" is a URL pattern, the indented lines under it are
#   "Name: value" headers, "#" starts a comment, and a blank line ends a rule.
#   "*" is a greedy splat. Limits: 100 rules per file, 2000 chars per line.
#
# ONE RULE THAT BITES: a request matching several patterns inherits the headers
# from all of them, and a header set twice has its values JOINED WITH A COMMA.
# So Cache-Control is deliberately absent from /* below. Setting it there and
# again on /assets/* would emit
#   Cache-Control: public, max-age=0, must-revalidate, public, max-age=31536000
# and the first max-age wins, which would kill caching on the hashed assets.
# Cache-Control therefore only ever appears on non-overlapping patterns.


# ---------------------------------------------------------------------------
# Security headers, every route (documents, assets, images, everything).
# ---------------------------------------------------------------------------
/*
  # Two years, subdomains included, and eligible for the browser preload list.
  # Only set this while the apex and every subdomain can serve HTTPS: preload
  # entries are slow and painful to back out of.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Stop browsers guessing a MIME type. Without it a .txt or an upload that
  # sniffs as HTML can be executed as a document on this origin.
  X-Content-Type-Options: nosniff

  # Send the full URL to same-origin destinations, the origin only when the
  # scheme stays HTTPS cross-origin, and nothing at all on a downgrade. Blog
  # posts link out heavily, so path leakage to third parties matters.
  Referrer-Policy: strict-origin-when-cross-origin

  # Clickjacking. frame-ancestors 'none' in the CSP below is the modern form
  # and takes precedence where both are understood; this stays for older
  # browsers that never implemented frame-ancestors.
  X-Frame-Options: DENY

  # No page here asks for a camera, a mic, or a location, so refuse for this
  # document and every embed. interest-cohort is the historical FLoC opt-out,
  # kept because some crawlers and scanners still look for it; browsing-topics
  # is the API that actually replaced it. Unknown feature names are ignored by
  # the parser, so listing both is safe.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()

  # Content-Security-Policy. Directive by directive:
  #
  #   default-src 'self'        fallback for anything not named below.
  #   script-src  'self'
  #                             No 'unsafe-inline'. It used to be here, on the
  #                             reasoning that a hash approach would need one
  #                             hash per page regenerated on every content
  #                             edit. Measured, that is not the shape of the
  #                             problem: across all 382 built pages there is
  #                             exactly ONE executable inline script, the boot
  #                             veil from client/index.html, byte identical
  #                             everywhere, so one hash covers the site.
  #                             The other 730 inline blocks are
  #                             type="application/ld+json", which the HTML
  #                             parser treats as a data block and never
  #                             prepares as a script, so script-src does not
  #                             gate them. Verified by serving the built site
  #                             under this exact policy: the boot script runs,
  #                             React mounts, every ld+json block still parses,
  #                             and no script-src violation is raised.
  #                             scripts-ci/check-csp-hash.mjs recomputes the
  #                             hash from the build and fails if it drifts from
  #                             the one below, or if a second executable inline
  #                             script ever appears.
  #   script-src  'wasm-unsafe-eval'
  #                             REQUIRED, and its absence was breaking the 3D
  #                             pages in production. /racks/wired loads
  #                             /draco/draco_decoder.wasm to decode the
  #                             compressed geometry, and compiling a
  #                             WebAssembly module needs an explicit grant.
  #                             Under the previous policy that page raised 13
  #                             WebAssembly compile errors and the models did
  #                             not decode.
  #                             This is NOT 'unsafe-eval'. It permits
  #                             WebAssembly compilation only; eval and
  #                             new Function stay blocked, which is what the
  #                             note further down about lodash inside recharts
  #                             is asking for.
  #   style-src                 Tailwind ships a stylesheet, but framer-motion
  #                             and GSAP animate by writing element.style on
  #                             every frame, which counts as inline style. The
  #                             Google Fonts origin serves the @font-face sheet.
  #   font-src                  the font files themselves come from gstatic.
  #                             data: covers any inlined face.
  #   img-src                   own images plus data: (inlined SVG/PNG) and
  #                             blob: (canvas readback, export.ts downloads).
  #   connect-src               /api/* is answered in-page by lib/local-api,
  #                             and nothing else calls out to a network origin:
  #                             'self' only, so any exfiltration attempt to a
  #                             third party is still refused. blob: is for the
  #                             Draco worker, which fetches its own module
  #                             through a blob URL it created; without it that
  #                             page raised 26 refused-to-connect errors. A
  #                             blob URL can only be read by the origin that
  #                             created it, so this does not open a path off
  #                             the site.
  #   worker-src                the service worker at /sw.js, plus blob: for
  #                             libraries that construct a worker from source.
  #   object-src 'none'         no Flash/Java/embed surface at all.
  #   frame-src 'none'          nothing is embedded; no iframes anywhere.
  #   frame-ancestors 'none'    nobody may embed this site.
  #   base-uri 'self'           an injected <base> cannot repoint every
  #                             relative asset URL at an attacker origin.
  #   form-action 'self'        an injected form cannot post credentials away.
  #   upgrade-insecure-requests belt and braces alongside HSTS.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-SwHGuGI0bYRIZC3y4iRrSw2WaPZ2TY6F5J54jws8Hs0='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' data: blob:; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests


# ---------------------------------------------------------------------------
# Caching. Every pattern below is disjoint from every other one, so no
# Cache-Control value is ever emitted twice for one request.
# ---------------------------------------------------------------------------

# Vite writes content-hashed filenames here (index-CV8h2284.js and friends), so
# the URL changes whenever the bytes do. A year, immutable, never revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Post covers and OG cards are NOT hashed: the path stays the same when an
# image is replaced. A week is long enough to help repeat readers and short
# enough that a swapped cover is not stuck in caches for a year.
/images/*
  Cache-Control: public, max-age=604800

# The hero rack model. 646 KB, requested only when someone opens the model
# view, and the filename is not hashed, so this follows /images/*: a week is
# long enough that a second visit does not pay for it twice, and short enough
# that a regenerated model is not stuck in caches. Regenerating it is a
# deliberate manual step, so a week of staleness is a known cost rather than
# a surprise.
/models/*
  Cache-Control: public, max-age=604800

# The service worker must never be served stale, or a bad worker keeps itself
# alive. Browsers already bypass the HTTP cache for the worker script after 24
# hours, but say it explicitly.
/sw.js
  Cache-Control: no-cache, must-revalidate

# HTML documents. These reference hashed asset filenames that disappear on the
# next deploy, so a cached copy must always be revalidated. Cloudflare Pages
# already defaults HTML to max-age=0, must-revalidate; these rules make the
# intent explicit for the routes that exist. A route not listed here still
# inherits that default, so a new page cannot accidentally become cacheable.
/
  Cache-Control: public, max-age=0, must-revalidate

/blog
  Cache-Control: public, max-age=0, must-revalidate

/blog/*
  Cache-Control: public, max-age=0, must-revalidate

/projects
  Cache-Control: public, max-age=0, must-revalidate

/contact
  Cache-Control: public, max-age=0, must-revalidate

/game
  Cache-Control: public, max-age=0, must-revalidate

/tools
  Cache-Control: public, max-age=0, must-revalidate

/tools/*
  Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------------------
# Crawler directives.
#
# X-Robots-Tag is the only way to say noindex for a route with no prerendered
# document of its own: those are served as the app shell, which carries the
# home page's meta tags, so without this a crawler reads the URL as a
# duplicate of the home page. robots.txt Disallow would be weaker, since a
# disallowed URL with inbound links can still be listed by URL alone.
#
# The five simulator dashboards no longer rest on that argument. They are
# prerendered with their own canonical and their own meta noindex, and the
# header below stays as a second signal that does not depend on a crawler
# reading the document. What it must never again be is the only signal:
# paired with the shell's canonical to the home page, a noindex on a
# different URL is the combination Google warns can transfer the noindex to
# the canonical target. Search Console reported those URLs as soft 404s.
#
# None of the /* rules above set X-Robots-Tag, so nothing is joined here.
# ---------------------------------------------------------------------------

# The simulator's internal dashboards. No prose, no standalone value, and
# indexing them spends crawl budget that belongs to the 236 articles.
/noc
  X-Robots-Tag: noindex, follow

/network
  X-Robots-Tag: noindex, follow

/floor
  X-Robots-Tag: noindex, follow

/incidents
  X-Robots-Tag: noindex, follow

/build
  X-Robots-Tag: noindex, follow

# The pre-redesign site used to be noindexed here. It is not served any more:
# _redirects 301s every /legacy URL to the page that replaced it, so there is
# no document at those addresses to keep out of the index, and a noindex on a
# redirect is at best noise and at worst a signal about the target. Removed
# rather than left as decoration.
